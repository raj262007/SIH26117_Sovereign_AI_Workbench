# ==============================================================================
# Sovereign On-Premise Agentic AI Workbench - Environment Configuration
# Team: rv2 | Hackathon: SIH 2026
# ==============================================================================

# Mode: 'local' (Ollama / on-premise air-gapped) or 'cloud' (Groq/Together API)
WORKBENCH_MODE=local

# --- Cloud LLM API Keys (For Phase 1 Prototyping) ---
GROQ_API_KEY=your_groq_api_key_here

# --- On-Device Local LLM (For Phase 2 Air-Gapped Demo) ---
OLLAMA_BASE_URL=http://localhost:11434

# --- Temporal.io Durable Orchestration (Optional) ---
# Start server with: temporal server start-dev
TEMPORAL_HOST=localhost:7233
TEMPORAL_TASK_QUEUE=sovereign-workbench

# --- Langfuse Observability & Audit Tracing (Optional) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
